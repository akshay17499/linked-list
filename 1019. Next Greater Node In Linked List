int* nextLargerNodes(struct ListNode* head, int* returnSize) 
{
   

   int count =0;
   struct ListNode*temp = head;
   while(temp!=NULL)
   {
    count++;
    temp = temp->next;
   } 
   int arr[count];
   temp=head;
   count=0;
   while(temp!=NULL)
   {
    arr[count++] = temp->val;
    temp=temp->next;
   }
   int stack[count];
   int top=-1;
   int*temp1 = malloc(sizeof(int)*count);
   * returnSize =count;
   for(int i =count-1;i>=0;i--)
   {
     while(top>=0&&stack[top]<=arr[i])
     top--;
     if(top==-1)
    temp1[i] = 0;
    else
    temp1[i] = stack[top];
    stack[++top] = arr[i];
   }
   return temp1;
}
